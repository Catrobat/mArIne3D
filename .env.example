# ==============================================================================
# Procedural Animation Generation Framework (animgen) - Environment Variables
# ==============================================================================
# Copy this file to .env and configure your Hugging Face credentials:
#   cp .env.example .env
# ==============================================================================

# Hugging Face Access Token
# Required for downloading Meta SAM3 (Segment Anything Model 3) foundation weights
# from https://huggingface.co/facebook/sam3
# Ensure your token has read permissions and your HF account has accepted the Meta SAM3 license.
HF_TOKEN=hf_your_huggingface_access_token_here

# Hugging Face Cache Directory (Optional)
# Directory where downloaded Hugging Face model weights and checkpoints are stored.
# Defaults to ./models_cache/SAM_original/ if omitted.
HF_HOME=./models_cache/SAM_original/

# PyTorch / CUDA Execution Device (Optional: cuda, cpu)
# Defaults to cuda if available, otherwise cpu.
# DEVICE=cuda

# Model precision dtype for SAM3 (Optional: bfloat16, float16, float32)
# Defaults to bfloat16 on Ampere+ GPUs, float16 on standard GPUs, float32 on CPU.
# TORCH_DTYPE=bfloat16
